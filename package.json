{
  "name": "phieuyeucau",
  "version": "1.0.0",
  "private": true,
  "description": "Quản lý phiếu yêu cầu - backend Cloudflare Worker (D1 + R2) phục vụ giao diện tĩnh HTML/CSS/JS.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply phieuyeucau --local",
    "db:migrate:remote": "wrangler d1 migrations apply phieuyeucau --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "typescript": "^5",
    "wrangler": "^4"
  },
  "dependencies": {
    "hono": "^4"
  }
}
